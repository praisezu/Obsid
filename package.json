{
    "name": "vanta",
    "version": "0.3.0",
    "description": "Vanta — a Discord client mod",
    "private": true,
    "license": "MIT",
    "repository": "github:praisezu/Obsid",
    "vanta": {
        "repo": "praisezu/Obsid"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "build:release": "node scripts/build.mjs --release",
        "watch": "node scripts/build.mjs --watch",
        "typecheck": "tsc -p .",
        "inject": "node scripts/install.js",
        "uninject": "node scripts/install.js --uninstall",
        "status": "node scripts/install.js --status",
        "package": "node scripts/package.mjs",
        "build:installer": "cd installer && go build -trimpath -ldflags \"-s -w -H windowsgui\" -o ../dist/VantaInstaller.exe ."
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "electron": "^45.2.3",
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2"
    }
}
